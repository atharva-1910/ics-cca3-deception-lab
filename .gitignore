# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Store / runtime state. Both the live DB and snapshots are regenerable from
# `make seed` (store/seed.py + topology.json), so neither is tracked.
store/*.db
store/*.sqlite
store/*.sqlite3
store/snapshots/*.db
store/*.db-journal
store/*.db-wal
store/*.db-shm

# Per-run generated ground truth (canonical copies live under results/<exp>/...).
/ground_truth.json
/ground_truth.d1.json

# Experiment outputs — raw logs are regenerated, never hand-edited.
# Keep the directory layout, ignore bulk run artifacts.
results/**/*.jsonl
results/**/*.transcript
results/**/transcript*
results/**/report.json
results/**/ground_truth.json
results/**/score.json
!results/**/.gitkeep

# Generated topology / compose overrides
topology.json
docker-compose.override.yml

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Keep the docx handover out of diffs only if large churn; keep it tracked for now.
